// Firestore security rules — owner-only. Each user can read/write only users/{their uid}/**.
// NOT auto-deployed: the live rules are in the Firebase console (project wheelhouse-61982). Compare and deploy with
//   firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Paid plan. Users may READ their own entitlement but never write it: only the Stripe webhook and the
    // founder tool (server side, service account) can change it, so nobody can give themselves Pro.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
